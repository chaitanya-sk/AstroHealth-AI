# AstroHealth AI - Frontend Environment Template
# Copy this file to '.env' and fill in your actual project values.
# NEVER commit your real '.env' file or service keys to version control.

# FastAPI Backend URL
VITE_API_BASE_URL=http://127.0.0.1:8000

# Supabase Project Configuration (From Project Settings -> API)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key

